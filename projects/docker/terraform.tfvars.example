# Copy to terraform.tfvars and adjust to your cloud:
#   openstack image list / openstack flavor list / openstack network list

image_name   = "Ubuntu 24.04"
flavor_name  = "m1.small"
network_name = "private"

# Needed when network_name is not directly reachable from your machine:
# floating_ip_pool = "public"

# Optional; omit to allow only your current public IPv4 address:
# admin_cidrs = ["203.0.113.0/24"]

# Optional: open published container ports to admin_cidrs
# app_tcp_ports = [8080]
